{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "ignorePaths": [],
  "ignoreDeps": [],
  "ignorePresets": [],
  "packageRules": [
    {
      // Tell the standard Go manager to ignore CI folders entirely
      "matchManagers": [
        "gomod"
      ],
      "matchPaths": [
        "ci/**",
        "ci/tests/**"
      ],
      "enabled": false
    },
    {
      // Target custom Dagger Engine updates
      "matchManagers": [
        "regex"
      ],
      "matchPaths": [
        "(^|/)dagger\\.json$"
      ],
      // Inject a prominent note to developers into the PR body
      "prBodyNotes": [
        "### ⚠️ Manual Action Required Before Merge",
        "Because this PR updates the Dagger Engine version, you **must** manually synchronize the Go boilerplate code locally before merging this PR:",
        "1. Check out this branch locally: `git checkout {{{branchName}}}`",
        "2. Navigate to your Dagger directory and run: `dagger develop`",
        "3. Run `go mod tidy` in your `ci/` and `ci/tests/` folders if needed.",
        "4. Commit and push the updated `go.mod` and `go.sum` files to this PR."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)dagger\\.json$"
      ],
      "matchStrings": [
        "\"engineVersion\":\\s*\"(?<currentValue>.*?)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "dagger/dagger"
    }
  ]
}
