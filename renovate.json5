{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  ignorePaths: [],
  ignoreDeps: [],
  ignorePresets: [],
  packageRules: [
    {
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'ci/**',
        'ci/tests/**',
      ],
      enabled: false,
    },
    {
      // Group Dagger updates together
      matchPackageNames: [
        'dagger/dagger'
      ],
      groupName: 'Dagger Engine',
      prBodyNotes: [
        '### ⚠️ Manual Action Required Before Merge',
        'Because this PR updates the Dagger Engine version, you **must** manually synchronize the Go boilerplate code locally before merging this PR:',
        '1. Check out this branch locally: `git checkout {{{branchName}}}`',
        '2. Navigate to your Dagger directory and run: `dagger develop`',
        '3. Run `go mod tidy` in your `ci/` and `ci/tests/` folders if needed.',
        '4. Commit and push the updated `go.mod` and `go.sum` files to this PR.',
      ],
    },
  ],
  customManagers: [
    {
      // Dagger Manager
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)dagger\\.json$/',
        '/^\\.github/workflows/release\\.yml$/',
      ],
      matchStrings: [
        '"engineVersion":\\s*"(?<currentValue>.*?)"',
        'version:\\s*"(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'dagger/dagger',
    },
    {
      // NetBird Manager
      customType: 'regex',
      managerFilePatterns: [
        'charts/netbird/Chart.yaml'
      ],
      matchStrings: [
        'appVersion:\\s*"(?<currentValue>[^"]+)"'
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'netbirdio/netbird-server',
    },
  ],
}